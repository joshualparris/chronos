# Chronos Backend environment variables
# Copy to .env and edit as needed

# Port the backend listens on (default: 3001)
PORT=3001

# Override the systemd user unit directory (default: ~/.config/systemd/user)
# CHRONOS_SYSTEMD_DIR=/home/youruser/.config/systemd/user

# CORS: which frontend origin is allowed (default: http://localhost:5173)
ALLOWED_ORIGIN=http://localhost:5173
